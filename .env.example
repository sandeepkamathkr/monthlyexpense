# Example environment variables for Docker Compose
# Copy this file to .env and customize the values

# Database Configuration
DB_NAME=monthly_expense_db
DB_USERNAME=admin
DB_PASSWORD=change_this_password_in_production

# Backend Configuration
BACKEND_PORT=8081
FRONTEND_PORT=80

# CORS Configuration (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost

# Optional: JWT Secret (if implementing authentication)
# JWT_SECRET=your-secret-key

# Optional: Database Host (for external databases)
# DB_HOST=localhost
# DB_PORT=5432